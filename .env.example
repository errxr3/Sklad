# Скопируйте в .env и задайте свои значения. Файл .env в репозиторий НЕ попадает.

# Ключ подписи cookie-сессий. Сгенерировать: python -c "import secrets;print(secrets.token_hex(32))"
SKLAD_SECRET_KEY=change-me-please

# Путь к файлу базы SQLite (по умолчанию data/sklad.db)
SKLAD_DB_PATH=data/sklad.db

# Сколько минут бездействия до выхода из системы
SKLAD_SESSION_MINUTES=720
